# Local PostgreSQL database used by Prisma.
DATABASE_URL="postgresql://reservapro:reservapro@localhost:5433/reservapro?schema=public"

# Authentication used by NextAuth.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
SEED_ADMIN_PASSWORD="Admin123!"

# Resend sends payment confirmations and schedules the 24-hour reminder.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ReservaPro <onboarding@resend.dev>"

# Webpay Plus integration credentials. Empty values use the official SDK integration credentials.
WEBPAY_COMMERCE_CODE=""
WEBPAY_API_KEY=""
