{
  "name": "reservapro",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24 <25" },
  "overrides": { "next": { "postcss": "8.5.26", "sharp": "0.35.4" }, "@prisma/config": { "effect": "3.22.1", "deepmerge-ts": "8.0.2" } },
  "scripts": {
    "dev": "next dev",
    "build": "npm run env:check && prisma generate && next build",
    "postinstall": "prisma generate",
    "env:check": "tsx scripts/check-env.ts",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "6.15.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "3.0.3",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.37.0",
    "next": "15.5.23",
    "next-auth": "4.24.15",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.25.0",
    "transbank-sdk": "^6.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "autoprefixer": "10.4.21",
    "eslint": "9.34.0",
    "eslint-config-next": "15.5.23",
    "postcss": "8.5.26",
    "prisma": "6.15.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
